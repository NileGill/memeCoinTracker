# Copy this file to .env to change settings. Everything is optional.

# Port and interface the server listens on. Keep 127.0.0.1 unless you deploy it somewhere.
PORT=3000
HOST=127.0.0.1

# A private Solana RPC (free from Helius, QuickNode, Triton...) makes trader tracking faster
# and more reliable than the public endpoint. Example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# Optional Jupiter API key from https://portal.jup.ag (raises Jupiter rate limits).
JUPITER_API_KEY=

# ---- Accounts (optional). Both a database and email are needed to turn logins on.

# Postgres connection string (a free Neon database works): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Email for verification and password-reset codes. With Gmail: turn on 2-Step Verification,
# create an app password at https://myaccount.google.com/apppasswords and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. MemeRadar <you@gmail.com>
MAIL_FROM=
